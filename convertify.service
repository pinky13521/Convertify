[Unit]
Description=Convertify Document Converter Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/convertify
ExecStart=/usr/bin/python3 /var/www/convertify/server.py
Restart=always
RestartSec=2s
KillMode=process
TimeoutStopSec=4s
Environment=PORT=8080
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
